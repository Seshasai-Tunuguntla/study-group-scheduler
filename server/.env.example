DATABASE_URL="postgresql://<user>@localhost:5432/study_scheduler"
JWT_SECRET="change-me-in-production"
PORT=4100
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN="http://localhost:5180"

# On Vercel with Neon, the Neon integration sets DATABASE_URL (pooled, used by the app) and
# DATABASE_URL_UNPOOLED (direct, used only to run migrations during the build).
# DATABASE_URL_UNPOOLED=""

# Set to true for one deployment to log how the first request's client address arrives
# (once per instance), to check the rate limiters see the visitor's address. Off by default.
# LOG_CLIENT_IP=true

# Vercel preview deployments: the API and migrations are off unless the preview has its own
# database (e.g. a Neon preview branch). Set to true for the Preview environment only, and only then.
# PREVIEW_HAS_OWN_DATABASE=true
