{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + Prisma API for the study group scheduler",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
